{
  "name": "killit",
  "version": "1.0.0",
  "description": "Smart, safe cross-platform port killer for developers",
  "bin": {
    "killit": "./bin/killit.js",
    "ki": "./bin/killit.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "prepublishOnly": "npm run build",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts' 'README.md'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts' 'README.md'"
  },
  "keywords": [
    "kill-port",
    "fkill",
    "port-killer",
    "free-port",
    "close-port",
    "process-killer",
    "zombie-processes",
    "cross-platform",
    "cli",
    "developer-tools",
    "safety-aware",
    "lsof",
    "netstat",
    "ss"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^10.4.0",
    "jest": "^29.0.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.59.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ]
}
